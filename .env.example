# ============================================
# iWantU Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================

# PostgreSQL connection string
DATABASE_URL=postgresql://iwantu:iwantu123@localhost:5432/iwantu

# JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=dev-secret-change-in-production

# SMTP mail server (used for email notifications and verification codes)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="iWantU <noreply@example.com>"

# Node environment: development | production | test
NODE_ENV=development

# Directory for uploaded files
UPLOAD_DIR=/data/uploads

# Governed R8 incentives: empty mapping disables registration and awards.
# Configure only in trusted server setup; never accept this mapping from a request.
# See docs/engineering/v2-m11-06-r8-governance-atomic-awards.md for the schema.
IWANTU_INCENTIVE_TRUSTED_PROGRAMS={}
