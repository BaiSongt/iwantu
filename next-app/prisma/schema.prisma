// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum UserRole {
  guest
  buyer
  supplier
  opc_team
  operator
  admin
}

enum OrgType {
  buyer
  supplier
  opc_team
}

enum DemandStatus {
  draft
  clarifying
  awaiting_quote
  collecting_proposals
  in_poc
  closed_deal
  closed
}

enum ProductStatus {
  draft
  pending_review
  published
  needs_info
  delisted
  flagged
}

enum PocStatus {
  not_started
  confirming_requirements
  uploading_sample_data
  supplier_testing
  result_review
  procurement_discussion
  completed
  terminated
}

enum SampleDataStatus {
  pending
  uploaded
  processing
}

enum PricingModel {
  subscription
  per_project
  per_seat
  pay_per_use
  custom
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum MessageThreadType {
  demand
  poc
  proposal
  general
}

enum ProposalStatus {
  draft
  submitted
  reviewed
  accepted
  rejected
}

enum AuditDecision {
  allowed
  denied
  pending
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum AttachmentTargetType {
  product
  demand
  proposal
  poc
  message
}

enum ReviewTargetType {
  product
  agent
  company
}

enum FeaturedItemType {
  product
  agent
  company
  solution
  team
}

enum VerificationPurpose {
  register
}

// v2 Identity & Authority domain enums.
enum PrincipalType {
  individual
  organization
}

enum PrincipalStatus {
  active
  suspended
}

enum AgentIdentityStatus {
  active
  suspended
  retired
}

enum AgentCredentialKind {
  api
  signing
  oauth_a2a
}

enum AgentCredentialStatus {
  active
  retired
  revoked
}

enum CapabilityClaimStatus {
  declared
  verified
}

// v2 Economy & Ledger domain enums.
enum LedgerAccountType {
  principal_available
  principal_locked
  principal_pending
  system_reserve
  system_clearing
  system_fee
  system_incentive
}

enum LedgerAccountStatus {
  active
  frozen
  closed
}

enum LedgerTransactionType {
  genesis
  purchased_credit
  contract_escrow
  settlement
  refund
  protocol_fee
  incentive
  penalty
  reserve
}

enum LedgerTransactionStatus {
  draft
  posted
}

enum LedgerEntrySide {
  debit
  credit
}

enum EscrowStatus {
  locked
  released
  refunded
}

// ============================================
// Models
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  avatar        String?
  role          UserRole @default(guest)
  orgId         String?
  phone         String?
  emailVerified DateTime?
  createdAt     DateTime @default(now())

  organization        Organization?          @relation(fields: [orgId], references: [id])
  organizationMembers OrganizationMember[]
  demands             Demand[]               @relation("DemandOwner")
  sentMessages        Message[]              @relation("MessageSender")
  threadParticipants  ThreadParticipant[]
  reviews             Review[]               @relation("ReviewAuthor")
  auditLogs           AuditLog[]              @relation("AuditLogUser")
  agentActions        AgentAction[]           @relation("AgentActionDelegator")
  apiKeys             ApiKey[]                @relation("ApiKeyOwner")
  notifications       Notification[]
  principal           Principal?              @relation("IndividualPrincipal")

  @@index([orgId])
  @@index([role])
  @@map("users")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  type        OrgType
  industry    String?
  description String?
  certified   Boolean  @default(false)
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  users          User[]
  members        OrganizationMember[]
  products       Product[]
  agentProducts  AgentProduct[]
  companyProfile CompanyProfile?
  solutions      Solution[]              @relation("OrgSolutions")
  principal      Principal?              @relation("OrganizationPrincipal")

  @@index([type])
  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("organization_members")
}

// ============================================
// v2 Identity & Authority Foundation (M1-01/M1-07)
// ============================================

model Principal {
  id             String          @id @default(cuid())
  type           PrincipalType
  status         PrincipalStatus @default(active)
  userId         String?         @unique
  organizationId String?         @unique
  createdAt      DateTime        @default(now())
  suspendedAt    DateTime?

  user               User?               @relation("IndividualPrincipal", fields: [userId], references: [id], onDelete: Restrict)
  organization       Organization?       @relation("OrganizationPrincipal", fields: [organizationId], references: [id], onDelete: Restrict)
  agents             AgentIdentity[]
  issuedMandates     Mandate[]           @relation("MandateIssuerPrincipal")
  mandateRevocations MandateRevocation[] @relation("MandateRevokedByPrincipal")
  ledgerAccounts     LedgerAccount[]

  @@index([type, status])
  @@map("principals")
}

model AgentIdentity {
  id                   String              @id @default(cuid())
  principalId          String
  legacyAgentProductId String?             @unique
  name                 String
  status               AgentIdentityStatus @default(active)
  createdAt            DateTime            @default(now())
  suspendedAt          DateTime?
  retiredAt            DateTime?

  principal          Principal        @relation(fields: [principalId], references: [id], onDelete: Restrict)
  legacyAgentProduct AgentProduct?    @relation("LegacyAgentProduct", fields: [legacyAgentProductId], references: [id], onDelete: SetNull)
  versions           AgentVersion[]
  credentials        AgentCredential[]
  mandates           Mandate[]        @relation("MandateSubjectAgent")
  delegatedMandates  Mandate[]        @relation("MandateDelegatingAgent")

  @@index([principalId, status])
  @@map("agent_identities")
}

model AgentVersion {
  id                           String   @id @default(cuid())
  agentIdentityId              String
  version                      String
  softwareVersion              String?
  runtimeMeta                  Json?
  modelMeta                    Json?
  capabilityImplementationMeta Json?
  createdAt                    DateTime @default(now())
  retiredAt                    DateTime?

  agentIdentity AgentIdentity @relation(fields: [agentIdentityId], references: [id], onDelete: Restrict)

  @@unique([agentIdentityId, version])
  @@index([agentIdentityId, createdAt])
  @@map("agent_versions")
}

model AgentCredential {
  id              String                @id @default(cuid())
  agentIdentityId String
  kind            AgentCredentialKind
  status          AgentCredentialStatus @default(active)
  keyId           String                @unique
  prefix          String?
  secretHash      String?
  publicKeyJwk    Json?
  algorithm       String?
  metadata        Json?
  validFrom       DateTime              @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  retiredAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime              @default(now())

  agentIdentity AgentIdentity @relation(fields: [agentIdentityId], references: [id], onDelete: Restrict)

  @@index([agentIdentityId, status])
  @@index([kind, status])
  @@index([expiresAt])
  @@map("agent_credentials")
}

model Mandate {
  id                        String   @id @default(cuid())
  mandateFamilyId           String
  version                   Int
  protocolVersion           String   @default("iwantu-mandate/0.1")
  issuerPrincipalId         String
  subjectAgentIdentityId    String
  actionScopes              String[]
  capabilityScopes          String[]
  economicLimits            Json
  resourcePolicy            Json
  dataPolicy                Json
  counterpartyPolicy        Json
  validFrom                 DateTime
  validUntil                DateTime?
  delegationAllowed         Boolean  @default(false)
  maxDelegationDepth        Int      @default(0)
  delegationDepth           Int      @default(0)
  parentMandateId           String?
  delegatingAgentIdentityId String?
  payloadHash               String
  signatureAlgorithm        String
  signatureKeyId            String
  signature                 String
  supersedesMandateId       String?  @unique
  createdAt                 DateTime @default(now())

  issuerPrincipal  Principal      @relation("MandateIssuerPrincipal", fields: [issuerPrincipalId], references: [id], onDelete: Restrict)
  subjectAgent     AgentIdentity  @relation("MandateSubjectAgent", fields: [subjectAgentIdentityId], references: [id], onDelete: Restrict)
  delegatingAgent  AgentIdentity? @relation("MandateDelegatingAgent", fields: [delegatingAgentIdentityId], references: [id], onDelete: Restrict)
  parentMandate    Mandate?       @relation("MandateDelegation", fields: [parentMandateId], references: [id], onDelete: Restrict)
  childDelegations Mandate[]      @relation("MandateDelegation")
  supersedes       Mandate?       @relation("MandateSupersession", fields: [supersedesMandateId], references: [id], onDelete: Restrict)
  supersededBy     Mandate?       @relation("MandateSupersession")
  revocation       MandateRevocation?

  @@unique([mandateFamilyId, version])
  @@unique([mandateFamilyId, payloadHash])
  @@index([issuerPrincipalId, createdAt])
  @@index([issuerPrincipalId, delegationDepth])
  @@index([subjectAgentIdentityId, validFrom])
  @@index([parentMandateId])
  @@index([delegatingAgentIdentityId])
  @@index([validUntil])
  @@map("mandates")
}

model MandateRevocation {
  id                   String   @id @default(cuid())
  mandateId            String   @unique
  revokedByPrincipalId String
  reasonCode           String
  reason               String?
  payloadHash          String
  signatureAlgorithm   String
  signatureKeyId       String
  signature            String
  revokedAt            DateTime @default(now())

  mandate            Mandate   @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  revokedByPrincipal Principal @relation("MandateRevokedByPrincipal", fields: [revokedByPrincipalId], references: [id], onDelete: Restrict)

  @@index([revokedByPrincipalId, revokedAt])
  @@map("mandate_revocations")
}

model AuthoritySnapshot {
  id                   String   @id @default(cuid())
  protocolVersion      String   @default("iwantu-authority-snapshot/0.1")
  principalId          String
  agentIdentityId      String
  credentialId         String
  credentialKeyId      String
  leafMandateId        String
  mandateChain         Json
  authorityChainHash   String
  effectiveAuthority   Json
  requestEvidence      Json
  resolvedAction       String
  resolvedCapabilityId String?
  resolvedAt           DateTime
  evidenceHash         String   @unique
  createdAt            DateTime @default(now())

  @@index([principalId, resolvedAt])
  @@index([agentIdentityId, resolvedAt])
  @@index([credentialId])
  @@index([leafMandateId])
  @@map("authority_snapshots")
}

// ============================================
// v2 Market & Discovery Foundation (M1-08)
// ============================================

model CapabilityDefinition {
  id          String   @id
  parentId    String?
  name        String
  description String?
  namespace   String
  version     String?
  schemaRef   String?
  status      String   @default("active")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([namespace, status])
  @@index([parentId])
  @@map("capability_definitions")
}

model AgentCapabilityClaim {
  id             String                @id @default(cuid())
  agentVersionId String
  capabilityId   String
  claimStatus    CapabilityClaimStatus @default(declared)
  descriptor     Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([agentVersionId, capabilityId])
  @@index([capabilityId, claimStatus])
  @@index([agentVersionId])
  @@map("agent_capability_claims")
}

model AgentMarketProfile {
  id                 String   @id @default(cuid())
  agentIdentityId    String   @unique
  summary            String?
  description        String?
  a2aCardUrl         String?
  acceptsPublicTasks Boolean  @default(true)
  availability       String   @default("available")
  extensions         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([availability, acceptsPublicTasks])
  @@map("agent_market_profiles")
}

// ============================================
// v2 Economy & Ledger Foundation (M2-01)
// ============================================

model LedgerAccount {
  id          String              @id @default(cuid())
  principalId String?
  type        LedgerAccountType
  status      LedgerAccountStatus @default(active)
  currency    String              @default("IWC")
  createdAt   DateTime            @default(now())
  closedAt    DateTime?

  principal    Principal?   @relation(fields: [principalId], references: [id], onDelete: Restrict)
  entries      LedgerEntry[]
  buyerEscrows Escrow[]     @relation("EscrowBuyerAccount")

  @@unique([principalId, type, currency])
  @@index([principalId, status])
  @@index([type, status])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id              String                  @id @default(cuid())
  type            LedgerTransactionType
  status          LedgerTransactionStatus @default(draft)
  referenceType   String
  referenceId     String
  idempotencyKey  String                  @unique
  metadata        Json?
  previousHash    String?
  transactionHash String?                 @unique
  createdAt       DateTime                @default(now())
  postedAt        DateTime?

  entries        LedgerEntry[]
  escrowLocks    Escrow[]      @relation("EscrowLockTransaction")
  escrowReleases Escrow[]      @relation("EscrowReleaseTransaction")
  escrowRefunds  Escrow[]      @relation("EscrowRefundTransaction")

  @@index([referenceType, referenceId])
  @@index([type, status, createdAt])
  @@index([previousHash])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  entryIndex    Int
  accountId     String
  side          LedgerEntrySide
  amount        Decimal         @db.Decimal(36, 8)
  provenance    Json?
  createdAt     DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, entryIndex])
  @@index([accountId, createdAt])
  @@index([transactionId, side])
  @@map("ledger_entries")
}

model Escrow {
  id                         String       @id @default(cuid())
  contractId                 String       @unique
  buyerAccountId             String
  amount                     Decimal      @db.Decimal(36, 8)
  currency                   String       @default("IWC")
  status                     EscrowStatus @default(locked)
  lockLedgerTransactionId    String       @unique
  releaseLedgerTransactionId String?      @unique
  refundLedgerTransactionId  String?      @unique
  createdAt                  DateTime     @default(now())
  releasedAt                 DateTime?
  refundedAt                 DateTime?

  buyerAccount             LedgerAccount      @relation("EscrowBuyerAccount", fields: [buyerAccountId], references: [id], onDelete: Restrict)
  lockLedgerTransaction    LedgerTransaction  @relation("EscrowLockTransaction", fields: [lockLedgerTransactionId], references: [id], onDelete: Restrict)
  releaseLedgerTransaction LedgerTransaction? @relation("EscrowReleaseTransaction", fields: [releaseLedgerTransactionId], references: [id], onDelete: Restrict)
  refundLedgerTransaction  LedgerTransaction? @relation("EscrowRefundTransaction", fields: [refundLedgerTransactionId], references: [id], onDelete: Restrict)

  @@index([buyerAccountId, status])
  @@index([status, createdAt])
  @@map("escrows")
}

model Product {
  id                       String        @id @default(cuid())
  orgId                    String
  name                     String
  summary                  String
  description              String        @default("")
  coverImage               String?
  category                 String
  industryTags             String[]
  capabilityTags           String[]
  deploymentModes          String[]
  pricingModel             PricingModel
  price                    String
  supportPoc               Boolean       @default(false)
  supportPrivateDeployment Boolean       @default(false)
  score                    String        @default("")
  rating                   Float         @default(0)
  caseCount                Int           @default(0)
  pocCount                 Int           @default(0)
  status                   ProductStatus @default(draft)
  accent                   String        @default("blue")
  shot                     String        @default("default")
  tags                     String[]
  createdAt                DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([status])
  @@index([category])
  @@map("products")
}

model AgentProduct {
  id              String        @id @default(cuid())
  orgId           String
  name            String
  summary         String
  description     String        @default("")
  taskGoal        String        @default("")
  inputSpec       String[]
  outputSpec      String[]
  toolCalls       String[]
  successRate     Float         @default(0)
  deploymentModes String[]
  pricingModel    PricingModel  @default(custom)
  price           String        @default("")
  supportPoc      Boolean       @default(false)
  riskLevel       RiskLevel     @default(low)
  status          ProductStatus @default(draft)
  tags            String[]
  deploy          String        @default("")
  accent          String        @default("blue")
  shot            String        @default("default")

  organization Organization   @relation(fields: [orgId], references: [id])
  agentIdentity AgentIdentity? @relation("LegacyAgentProduct")

  @@index([orgId])
  @@index([status])
  @@map("agent_products")
}

model CompanyProfile {
  id                 String   @id @default(cuid())
  orgId              String   @unique
  slogan             String
  description        String
  certifications     String[]
  capabilities       String[]
  industryExperience String[]
  deliveryScope      String[]
  caseStudies        String[]
  rating             Float    @default(0)
  responseRate       Float    @default(0)
  certified          Boolean  @default(false)
  tags               String[]

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("company_profiles")
}

model Demand {
  id                    String       @id @default(cuid())
  ownerUserId           String
  ownerOrgId            String?
  title                 String
  industry              String
  budgetMin             Float?
  budgetMax             Float?
  budgetRange           String
  deliveryPeriod        String
  dataTypes             String[]
  deploymentRequirement String
  description           String       @default("")
  painPoints            String       @default("")
  existingSystems       String       @default("")
  supportPoc            Boolean      @default(false)
  allowAiSupplier       Boolean      @default(false)
  allowAiAutoBid        Boolean      @default(false)
  status                DemandStatus @default(draft)
  matchScore            String       @default("")
  matchScoreNum         Float        @default(0)
  createdAt             DateTime     @default(now())

  ownerUser   User          @relation("DemandOwner", fields: [ownerUserId], references: [id])
  proposals   Proposal[]
  pocProjects PocProject[]

  @@index([ownerUserId])
  @@index([ownerOrgId])
  @@index([status])
  @@index([industry])
  @@index([createdAt])
  @@map("demands")
}

model Solution {
  id                    String   @id @default(cuid())
  orgId                 String?
  title                 String
  summary               String
  description           String   @default("")
  industry              String[]
  scenario              String
  budgetRange           String?
  deploymentModes       String[]
  deliveryPeriod        String?
  supportPoc            Boolean  @default(true)
  components            String[]
  recommendedProductIds String[]
  recommendedCompanyIds String[]
  createdAt             DateTime @default(now())

  organization Organization? @relation("OrgSolutions", fields: [orgId], references: [id])

  @@index([orgId])
  @@map("solutions")
}

model PocProject {
  id                 String           @id @default(cuid())
  demandId           String
  productId          String?
  supplierOrgId      String?
  status             PocStatus        @default(not_started)
  testMetrics        String[]
  acceptanceCriteria String[]
  sampleDataStatus   SampleDataStatus @default(pending)
  startDate          DateTime         @default(now())
  endDate            DateTime?

  demand       Demand           @relation(fields: [demandId], references: [id])
  participants PocParticipant[]

  @@index([demandId])
  @@index([status])
  @@map("poc_projects")
}

model PocParticipant {
  id           String @id @default(cuid())
  pocProjectId String
  userId       String
  role         String
  orgId        String

  pocProject PocProject @relation(fields: [pocProjectId], references: [id], onDelete: Cascade)

  @@index([pocProjectId])
  @@index([userId])
  @@map("poc_participants")
}

model Proposal {
  id             String         @id @default(cuid())
  demandId       String
  supplierOrgId  String
  title          String
  scope          String
  price          Float
  currency       String         @default("CNY")
  deliveryPeriod String?
  status         ProposalStatus @default(draft)
  createdAt      DateTime       @default(now())

  demand     Demand      @relation(fields: [demandId], references: [id])
  milestones Milestone[]
  quoteItems QuoteItem[]

  @@index([demandId])
  @@index([supplierOrgId])
  @@index([status])
  @@map("proposals")
}

model Milestone {
  id           String   @id @default(cuid())
  proposalId   String
  name         String
  description  String?
  duration     String
  deliverables String[]

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("milestones")
}

model QuoteItem {
  id          String @id @default(cuid())
  proposalId  String
  name        String
  description String?
  quantity    Float  @default(1)
  unit        String @default("项")
  unitPrice   Float
  totalPrice  Float

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("quote_items")
}

model MessageThread {
  id            String            @id @default(cuid())
  title         String
  type          MessageThreadType
  relatedId     String?
  lastMessage   String            @default("")
  lastMessageAt DateTime          @default(now())

  messages     Message[]
  participants ThreadParticipant[]

  @@index([type])
  @@index([relatedId])
  @@map("message_threads")
}

model Message {
  id            String   @id @default(cuid())
  threadId      String
  senderId      String
  senderName    String
  content       String
  isAiGenerated Boolean  @default(false)
  timestamp     DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@map("messages")
}

model ThreadParticipant {
  id       String @id @default(cuid())
  threadId String
  userId   String

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model AuditLog {
  id            String        @id @default(cuid())
  agentId       String?
  userId        String
  action        String
  targetType    String
  targetId      String
  riskLevel     RiskLevel
  decision      AuditDecision
  inputPayload  String?
  outputPayload String?
  createdAt     DateTime      @default(now())

  user User @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([agentId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model AgentAction {
  id              String         @id @default(cuid())
  agentId         String?
  delegatorUserId String?
  organizationId  String?
  actionType      String
  targetType      String
  targetId        String
  inputPayload    String?
  outputPayload   String?
  riskLevel       RiskLevel      @default(low)
  decision        AuditDecision  @default(allowed)
  approvalStatus  ApprovalStatus @default(pending)
  createdAt       DateTime       @default(now())

  delegator User? @relation("AgentActionDelegator", fields: [delegatorUserId], references: [id])

  @@index([agentId])
  @@index([organizationId])
  @@index([targetType, targetId])
  @@map("agent_actions")
}

model ApiKey {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  userId     String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation("ApiKeyOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
  @@map("api_keys")
}

model Attachment {
  id          String               @id @default(cuid())
  targetType  AttachmentTargetType
  targetId    String
  fileName    String
  fileSize    Float
  fileType    String
  url         String
  isSensitive Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([targetType, targetId])
  @@map("attachments")
}

model Review {
  id         String           @id @default(cuid())
  targetType ReviewTargetType
  targetId   String
  userId     String
  rating     Int // 1-5
  title      String
  content    String
  status     String           @default("published") // published, hidden
  createdAt  DateTime         @default(now())

  author User @relation("ReviewAuthor", fields: [userId], references: [id])

  @@index([targetType, targetId])
  @@index([userId])
  @@map("reviews")
}

model FeaturedItem {
  id          String           @id @default(cuid())
  itemType    FeaturedItemType
  itemId      String
  title       String
  description String?
  position    Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  @@index([itemType])
  @@index([active])
  @@map("featured_items")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // proposal_received, proposal_accepted, poc_status, message, system
  title     String
  content   String
  read      Boolean  @default(false)
  link      String? // URL to related resource
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model EmailVerificationCode {
  id         String              @id @default(cuid())
  email      String
  codeHash   String
  purpose    VerificationPurpose @default(register)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([email])
  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_verification_codes")
}
